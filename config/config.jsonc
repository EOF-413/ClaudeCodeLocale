{
  // ─────────────────────────────────────────────
  // МОДЕЛЬ (Model)
  // ─────────────────────────────────────────────
  // Выбирайте модель под задачу.
  // ВНИМАНИЕ: модель ДОЛЖНА поддерживать Tool Calling, иначе 
  // Claude Code не сможет читать файлы и работать с командами.
  "model": "claude-local",

  // ─────────────────────────────────────────────
  // ДЛИНА КОНТЕКСТА (Context Length)
  // ─────────────────────────────────────────────
  // Claude Code прожорлив к контексту (читает файлы, историю).
  // Минимум: 32000. Рекомендуется: 64000 и выше.
  "context_length": 256000,

  // ─────────────────────────────────────────────
  // РЕЖИМ ПАМЯТИ (Memory Mode)
  // ─────────────────────────────────────────────
  // "vram"   - грузить всё в видеопамять (быстро, но нужна GPU)
  // "ram"    - только RAM/CPU (медленно, но работает везде)
  // "hybrid" - Ollama сам распределяет слои
  // Для картинок (Vision) настоятельно рекомендуется "vram" или "hybrid".
  "memory_mode": "hybrid",

  // ─────────────────────────────────────────────
  // АДРЕС OLLAMA (Ollama Host)
  // ─────────────────────────────────────────────
  "ollama_host": "127.0.0.1:11434",

  // ─────────────────────────────────────────────
  // ВРЕМЯ УДЕРЖАНИЯ В ПАМЯТИ (Keep Alive)
  // ─────────────────────────────────────────────
  // "5m"  - 5 минут (экономит VRAM)
  // "30m" - 30 минут (рекомендуется)
  // "-1"  - держать вечно (мгновенный отклик)
  "keep_alive": "30m",

  // ─────────────────────────────────────────────
  // FLASH ATTENTION (Ускорение)
  // ─────────────────────────────────────────────
  // true  - ускорение и экономия памяти (рекомендуется для GPU)
  // false - выключить, если модель падает
  "flash_attention": true,

  // ─────────────────────────────────────────────
  // ТИП КВАНТОВАНИЯ KV-КЭША (KV Cache Type)
  // ─────────────────────────────────────────────
  // "f16"   - максимум качества, много памяти
  // "q8_0"  - 8-бит (рекомендуется, экономит ~50% памяти)
  // "q4_0"  - 4-бит (сильная экономия, возможны галлюцинации)
  "kv_cache_type": "q8_0",

  // ─────────────────────────────────────────────
  // ИНСТРУМЕНТЫ (MCP - Model Context Protocol)
  // ─────────────────────────────────────────────
  // Чтобы модель могла искать в интернете, ей нужны MCP-серверы.
  // Инструменты подключаются отдельно и прописываются в ~/.claude.json.
  // 
  // 1. Web Search & Fetch:
  //    - google-search-mcp (поиск в Google + вытягивание текста страниц)
  // 2. Обработка картинок:
  //    - НЕ требует MCP, если у модели есть встроенный Vision.
  "enable_mcp": true

  // ═══════════════════════════════════════════════════════════════════════
  //                        ТАБЛИЦА МОДЕЛЕЙ ДЛЯ OLLAMA
  // ═══════════════════════════════════════════════════════════════════════
  //
  // ┌──────────────────────┬──────────┬──────────┬──────────┬────────────────────────────────────────────┐
  // │ Модель (ollama run)  │ Контекст │ ToolCall │  Vision  │ Описание / Для чего лучше всего            │
  // ├──────────────────────┼──────────┼──────────┼──────────┼────────────────────────────────────────────┤
  // │ qwen2.5-coder:32b    │ 128K     │   ДА     │   НЕТ    │ Идеальна для кода. Лучший выбор, если      │
  // │                      │          │          │          │ хватает VRAM (нужно ~20GB).                │
  // ├──────────────────────┼──────────┼──────────┼──────────┼────────────────────────────────────────────┤
  // │ qwen2.5-coder:14b    │ 32K      │   ДА     │   НЕТ    │ Отличный компромисс для средних ПК.        │
  // │                      │          │          │          │ Легко влезает в 8-12GB VRAM.               │
  // ├──────────────────────┼──────────┼──────────┼──────────┼────────────────────────────────────────────┤
  // │ qwen2.5-vl:7b        │ 128K     │   ДА     │   ДА     │ Баланс: видит картинки И пишет код.        │
  // │                      │          │          │          │ Лучший выбор, если нужно кидать скрины.    │
  // ├──────────────────────┼──────────┼──────────┼──────────┼────────────────────────────────────────────┤
  // │ minicpm-v            │ 256K     │   НЕТ*   │   ДА     │ Супер OCR (читает текст с фото/скринов).   │
  // │                      │          │          │          │ *Часто не умеет вызывать инструменты.      │
  // ├──────────────────────┼──────────┼──────────┼──────────┼────────────────────────────────────────────┤
  // │ qwen3.5:35b-a3b      │ 256K     │   ДА     │   ДА     │ Мощная MoE-модель (быстрая). Жрет много    │
  // │                      │          │          │          │ памяти, но если есть 24GB+ VRAM — топ.     │
  // ├──────────────────────┼──────────┼──────────┼──────────┼────────────────────────────────────────────┤
  // │ llama3.3:70b         │ 128K     │   ДА     │   НЕТ    │ Очень умная, но тяжелая (~40GB). Для       │
  // │                      │          │          │          │ кодинга слабее Qwen, но общается отлично.  │
  // ├──────────────────────┼──────────┼──────────┼──────────┼────────────────────────────────────────────┤
  // │ deepseek-r1:14b      │ 64K      │   ДА     │   НЕТ    │ Любит рассуждать (Chain of Thought).       │
  // │                      │          │          │          │ Может зависать на простых задачах.         │
  // └──────────────────────┴──────────┴──────────┴──────────┴────────────────────────────────────────────┘
  //
  // ПРИМЕЧАНИЯ:
  // - Tool Calling: без этого Claude Code не сможет редактировать ваши файлы.
  // - Vision: нужен, если хотите скидывать скриншоты ошибок или макеты дизайна.
  // - Если модель съедает всю VRAM и падает, смените memory_mode на "hybrid".
} 